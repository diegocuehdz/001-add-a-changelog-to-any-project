{
  "name": "changelog",
  "version": "1.3.2",
  "description": "",
  "main": "index.js",
  "scripts": {
    "release": "release-it",
    "release:ci": "release-it --ci"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegocuehdz/001-add-a-changelog-to-any-project.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/diegocuehdz/001-add-a-changelog-to-any-project/issues"
  },
  "homepage": "https://github.com/diegocuehdz/001-add-a-changelog-to-any-project#readme",
  "dependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@release-it/conventional-changelog": "^10.0.0",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "release-it": "^18.1.2"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {}
          ]
        }
      }
    }
  }
}
